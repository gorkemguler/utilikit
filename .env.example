# ---------------------------------------------------------------------------
# Utilikit configuration. Copy to `.env` and edit. Every key is also a real
# environment variable (systemd EnvironmentFile, Docker -e, …).
# ---------------------------------------------------------------------------

# -- server -----------------------------------------------------------------
UTILIKIT_HOST=0.0.0.0
UTILIKIT_PORT=8400
UTILIKIT_LOG_LEVEL=INFO
UTILIKIT_DATA_DIR=./var
# Used to build absolute links for the shortener / request bin (optional).
UTILIKIT_PUBLIC_BASE_URL=

# -- auth -----------------------------------------------------------------
# Comma-separated API keys. EMPTY = the API is open (fine on a trusted LAN).
# Generate one:  utilikit gen-key
UTILIKIT_API_KEYS=

# -- rate limiting (per API key, or per client IP) -------------------------
UTILIKIT_RATE_LIMIT_PER_MIN=120
UTILIKIT_RATE_LIMIT_BURST=40

# -- outbound fetch / SSRF guard ----------------------------------------
# Leave false unless you fully trust every caller: it lets the fetch tools
# reach 127.0.0.1 / 10.x / 192.168.x / cloud-metadata addresses.
UTILIKIT_ALLOW_PRIVATE_FETCH=false
UTILIKIT_FETCH_TIMEOUT_SECONDS=15
UTILIKIT_FETCH_MAX_BYTES=8000000
UTILIKIT_FETCH_MAX_REDIRECTS=5
UTILIKIT_FETCH_USER_AGENT=Utilikit/0.1 (+https://github.com/gorkemguler/utilikit)
# Optional: if set, ONLY these host suffixes may be fetched (comma-separated).
UTILIKIT_FETCH_ALLOW_HOSTS=
UTILIKIT_FETCH_DENY_HOSTS=

# -- headless browser (screenshot / pdf / render) -----------------------
UTILIKIT_BROWSER_ENABLED=true
UTILIKIT_BROWSER_CONCURRENCY=1
UTILIKIT_BROWSER_TIMEOUT_SECONDS=30
UTILIKIT_BROWSER_NAV_TIMEOUT_SECONDS=20

# -- caching / jobs ---------------------------------------------------
UTILIKIT_CACHE_TTL_SECONDS=300
UTILIKIT_CACHE_MAX_ENTRIES=512
UTILIKIT_JOB_TTL_SECONDS=900

# -- request bin / shortener ----------------------------------------
UTILIKIT_BIN_MAX_REQUESTS=50
UTILIKIT_SHORTENER_ENABLED=true

# -- optional offline IP geolocation --------------------------------
# Provide a MaxMind GeoLite2 / DB-IP Lite .mmdb and `pip install utilikit[geo]`.
UTILIKIT_GEOIP_MMDB_PATH=./data/GeoLite2-City.mmdb
